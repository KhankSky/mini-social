<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.minisocial.desktop.view.feed.FeedController"
            fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="feed-scroll">
    <VBox spacing="16" alignment="TOP_CENTER">
        <padding>
            <Insets top="32.0" right="32.0" bottom="32.0" left="32.0"/>
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="12" maxWidth="800">
            <Label text="Feeds" styleClass="feed-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ToggleButton text="Recents" selected="true" styleClass="tab-button"/>
        </HBox>

        <VBox spacing="12" maxWidth="800" styleClass="compose-card">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Circle radius="22" fill="linear-gradient(to bottom, #6366f1, #a855f7)"/>
                <TextArea fx:id="composeText" promptText="Share something..." prefRowCount="2" wrapText="true" HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Selected Images Preview -->
            <HBox fx:id="selectedImagesContainer" spacing="8" alignment="CENTER_LEFT" managed="false" visible="false">
                <padding>
                    <Insets top="8.0" bottom="8.0" left="8.0" right="8.0"/>
                </padding>
                <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" fitToHeight="true" styleClass="images-preview-scroll">
                    <HBox fx:id="selectedImagesBox" spacing="8" alignment="CENTER_LEFT"/>
                </ScrollPane>
            </HBox>
            
            <HBox fx:id="locationContainer" spacing="8" alignment="CENTER_LEFT" 
                managed="false" visible="false" styleClass="location-container">
                <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16" iconColor="#6366f1"/>
                <TextField fx:id="locationField" promptText="Search location..." 
                        HBox.hgrow="ALWAYS" styleClass="location-field"/>
                <Button fx:id="searchLocationButton" text="Search" 
                        onAction="#handleSearchLocation" styleClass="secondary-button"/>
                <Button fx:id="clearLocationButton" onAction="#handleClearLocation" 
                        styleClass="ghost-button">
                    <graphic>
                        <FontIcon iconLiteral="fas-times" iconSize="14" iconColor="#ef4444"/>
                    </graphic>
                </Button>
            </HBox>
            
            <!-- Location Results Dropdown -->
            <VBox fx:id="locationResultsBox" spacing="4" managed="false" visible="false" 
                styleClass="location-results" maxHeight="200">
                <padding>
                    <Insets top="8.0" bottom="8.0" left="8.0" right="8.0"/>
                </padding>
            </VBox>
            
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="uploadImageButton" onAction="#handleAddImage" styleClass="ghost-button">
                    <graphic>
                        <HBox spacing="6" alignment="CENTER">
                            <FontIcon iconLiteral="fas-image" iconSize="14" iconColor="#374151"/>
                            <Label text="Image" styleClass="button-label"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button onAction="#handleAddLocation" styleClass="ghost-button">
                    <graphic>
                        <HBox spacing="6" alignment="CENTER">
                            <FontIcon iconLiteral="fas-map-marker-alt" iconSize="16" iconColor="#6366f1"/>
                            <Label text="Location" styleClass="button-label"/>
                        </HBox>
                    </graphic>
                </Button>
                <Button styleClass="ghost-button">
                    <graphic>
                        <HBox spacing="6" alignment="CENTER">
                            <FontIcon iconLiteral="fas-user-friends" iconSize="14" iconColor="#374151"/>
                            <Label text="Friends" styleClass="button-label"/>
                        </HBox>
                    </graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="publishButton" text="Send" onAction="#handlePublish" styleClass="primary-button"/>
            </HBox>
        </VBox>

        <VBox fx:id="postsContainer" spacing="12" maxWidth="800"/>
    </VBox>
</ScrollPane>