<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.minisocial.desktop.view.friends.FriendsController"
            fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: #f9fafb;">
    <VBox spacing="24" alignment="TOP_CENTER">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>
        <VBox spacing="8" maxWidth="800">
            <Label text="Friends" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: linear-gradient(to right, #9333ea, #2563eb);"/>
            <Label text="Manage your connections and find new friends" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;"/>
        </VBox>

        <!-- Tabs -->
        <HBox spacing="8" maxWidth="800" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <ToggleButton fx:id="friendsTab" selected="true" text="👥 My Friends" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tab-button" onAction="#handleTabChange"/>
            <ToggleButton fx:id="requestsTab" text="📬 Requests" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tab-button" onAction="#handleTabChange"/>
            <ToggleButton fx:id="findTab" text="🔍 Find Friends" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="tab-button" onAction="#handleTabChange"/>
        </HBox>

        <!-- Content Area -->
        <VBox fx:id="contentContainer" spacing="16" maxWidth="800" style="-fx-background-color: rgba(255,255,255,0.8); -fx-background-radius: 20; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
            <!-- Items will be loaded here -->
            <VBox fx:id="itemsList" spacing="12"/>
            
            <VBox fx:id="loadingView" alignment="CENTER" spacing="12" managed="false" visible="false">
                <ProgressIndicator maxWidth="40" maxHeight="40"/>
                <Label text="Loading..."/>
            </VBox>
            
            <VBox fx:id="emptyView" alignment="CENTER" spacing="12" managed="false" visible="false">
                <Label fx:id="emptyEmoji" text="😊" style="-fx-font-size: 48px;"/>
                <Label fx:id="emptyTitle" text="No friends yet" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="emptySubtitle" text="Start by finding and adding friends!" style="-fx-text-fill: #6b7280;"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
