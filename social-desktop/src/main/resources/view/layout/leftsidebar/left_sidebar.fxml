<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.minisocial.desktop.view.layout.leftsidebar.LeftSidebarController"
      spacing="16" prefWidth="240" styleClass="sidebar-left">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/>
    </padding>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <StackPane>
            <ImageView fx:id="avatarImageView" fitWidth="56" fitHeight="56" pickOnBounds="true" preserveRatio="true"/>
        </StackPane>
        <VBox spacing="4">
            <Label fx:id="fullNameLabel" styleClass="profile-name" text="User Name"/>
            <Label fx:id="usernameLabel" styleClass="profile-username" text="@username"/>
        </VBox>
    </HBox>

    <VBox spacing="8">
        <Button fx:id="feedButton" maxWidth="Infinity" styleClass="nav-button,primary-nav" onAction="#handleFeed">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-newspaper" iconSize="16" iconColor="white"/>
                    <Label text="News Feed" styleClass="nav-label"/>
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="messagesButton" maxWidth="Infinity" styleClass="nav-button" onAction="#handleMessages">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-envelope" iconSize="16" iconColor="#1f2937"/>
                    <Label text="Messages" styleClass="nav-label"/>
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="notificationsButton" maxWidth="Infinity" styleClass="nav-button" onAction="#handleNotifications">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane>
                        <FontIcon iconLiteral="fas-bell" iconSize="16" iconColor="#1f2937"/>
                        <Circle fx:id="notificationIndicator"
                                radius="6"
                                fill="red"
                                visible="false"
                                style="-fx-stroke: white; -fx-stroke-width: 1;"/>
                    </StackPane>
                    <Label text="Notifications" styleClass="nav-label"/>
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="friendsButton" maxWidth="Infinity" styleClass="nav-button" onAction="#handleFriends">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-user-friends" iconSize="16" iconColor="#1f2937"/>
                    <Label text="Friends" styleClass="nav-label"/>
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="searchButton" maxWidth="Infinity" styleClass="nav-button" onAction="#handleSearch">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-search" iconSize="16" iconColor="#1f2937"/>
                    <Label text="Search" styleClass="nav-label"/>
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="settingsButton" maxWidth="Infinity" styleClass="nav-button" onAction="#handleSettings">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-cog" iconSize="16" iconColor="#1f2937"/>
                    <Label text="Settings" styleClass="nav-label"/>
                </HBox>
            </graphic>
        </Button>
        <Button fx:id="logoutButton" maxWidth="Infinity" styleClass="nav-button" onAction="#handleLogout">
            <graphic>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <FontIcon iconLiteral="fas-sign-out-alt" iconSize="16" iconColor="#ef4444"/>
                    <Label text="Logout" styleClass="nav-label"/>
                </HBox>
            </graphic>
        </Button>
    </VBox>
</VBox>
