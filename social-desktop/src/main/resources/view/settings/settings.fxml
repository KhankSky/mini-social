<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.minisocial.desktop.view.settings.SettingsController">
    <padding>
        <Insets bottom="30" left="40" right="40" top="30" />
    </padding>

    <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Settings" />

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Edit Profile">
                <content>
                    <VBox spacing="16">
                        <padding>
                            <Insets top="20" />
                        </padding>
                        
                        <VBox spacing="8">
                            <Label style="-fx-font-weight: bold;" text="Username" />
                            <TextField fx:id="usernameField" promptText="Enter username" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-weight: bold;" text="Bio" />
                            <TextArea fx:id="bioArea" prefHeight="100" promptText="Tell something about yourself..." wrapText="true" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-weight: bold;" text="Avatar URL" />
                            <TextField fx:id="avatarUrlField" promptText="https://example.com/avatar.png" />
                        </VBox>

                        <Button onAction="#handleProfileSave" style="-fx-background-color: black; -fx-text-fill: white; -fx-padding: 10 20;" text="Save Changes" />
                    </VBox>
                </content>
            </Tab>
            
            <Tab text="Security">
                <content>
                    <VBox spacing="16">
                        <padding>
                            <Insets top="20" />
                        </padding>

                        <VBox spacing="8">
                            <Label style="-fx-font-weight: bold;" text="Current Password" />
                            <PasswordField fx:id="currentPasswordField" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-weight: bold;" text="New Password" />
                            <PasswordField fx:id="newPasswordField" />
                        </VBox>

                        <VBox spacing="8">
                            <Label style="-fx-font-weight: bold;" text="Confirm New Password" />
                            <PasswordField fx:id="confirmPasswordField" />
                        </VBox>

                        <Button onAction="#handleChangePassword" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20;" text="Change Password" />
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
