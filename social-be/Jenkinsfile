pipeline {
    agent any
    
    environment {
        // Thông tin Image
        DOCKER_IMAGE = 'khanksky/social-be'
        DOCKER_TAG = 'latest'
        DOCKER_CRED_ID = 'docker-hub-credentials' // ID bạn đặt trong Jenkins
        
        // Thông tin Server Deploy
        APP_SERVER_IP = '192.168.1.202'
        APP_SERVER_USER = 'khanhsky'
        DEPLOY_DIR = '~/deploy/social' // Thư mục chứa file deploy.sh trên server
    }
    
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    echo '=== Building Docker Image ==='
                    // Build image từ thư mục hiện tại (.)
                    // Lưu ý: Jenkins sẽ tự tìm Dockerfile trong thư mục social-be
                    dir('social-be') {
                        dockerImage = docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                    }
                }
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                script {
                    echo '=== Pushing to Docker Hub ==='
                    // Đăng nhập và Push
                    docker.withRegistry('', DOCKER_CRED_ID) {
                        dockerImage.push()
                    }
                }
            }
        }
        
        stage('Deploy to App Server') {
            steps {
                echo '=== Deploying to App Server ==='
                // Sử dụng SSH Agent để kết nối
                sshagent(['app-server-ssh-key']) {
                    // SSH vào server và chạy script deploy có sẵn
                    sh "ssh -o StrictHostKeyChecking=no ${APP_SERVER_USER}@${APP_SERVER_IP} 'cd ${DEPLOY_DIR} && ./deploy.sh'"
                }
            }
        }
    }
}
