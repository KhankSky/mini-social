pipeline {
    agent any

    parameters {
        string(name: 'BRANCH_NAME', defaultValue: 'develop', description: 'Nhánh code cần build (ví dụ: main, develop)')
    }
    
    environment {
        // Thông tin Image
        DOCKER_IMAGE = 'khanksky/social-be'
        DOCKER_TAG = 'latest'
        DOCKER_CRED_ID = 'docker-hub-credentials' // ID bạn đặt trong Jenkins
        
        // Thông tin Server Deploy
        APP_SERVER_IP = '159.223.76.30'
        APP_SERVER_USER = 'root'
        DEPLOY_DIR = '/app/social' // Thư mục chứa file deploy.sh trên server
    }
    
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    echo '=== Building Docker Image ==='
                    // Build image từ thư mục hiện tại (.)
                    // Lưu ý: Jenkins sẽ tự tìm Dockerfile trong thư mục social-be
                    dir('social-be') {
                        dockerImage = docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                    }
                }
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                script {
                    echo '=== Pushing to Docker Hub ==='
                    // Đăng nhập và Push
                    docker.withRegistry('', DOCKER_CRED_ID) {
                        dockerImage.push()
                    }
                }
            }
        }
        
        stage('Deploy to App Server') {
            steps {
                echo '=== Deploying to App Server ==='
                // Sử dụng SSH Agent để kết nối
                sshagent(['app-server-ssh-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${APP_SERVER_USER}@${APP_SERVER_IP} '
                            mkdir -p ${DEPLOY_DIR}
                            cd ${DEPLOY_DIR}
                            # Pull image mới nhất
                            docker pull ${DOCKER_IMAGE}:${DOCKER_TAG}
                            
                            # Chạy lại container (nếu dùng docker-compose thì gọi lệnh up -d)
                            # Ở đây giả sử bạn đã copy file docker-compose.prod.yml lên server rồi
                            # Nếu chưa thì cần scp file lên trước
                        '
                        # Copy file docker-compose.prod.yml lên server
                        scp -o StrictHostKeyChecking=no social-be/docker-compose.prod.yml ${APP_SERVER_USER}@${APP_SERVER_IP}:${DEPLOY_DIR}/docker-compose.yml
                        
                        # Chạy docker-compose up
                        ssh -o StrictHostKeyChecking=no ${APP_SERVER_USER}@${APP_SERVER_IP} '
                            cd ${DEPLOY_DIR}
                            export DOCKER_HUB_USERNAME=khanksky
                            docker compose down
                            docker compose up -d
                        '
                    """
                }
            }
        }
    }
}
